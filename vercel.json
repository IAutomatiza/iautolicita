{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "trailingSlash": false,
  "redirects": [
    { "source": "/fb", "destination": "/?utm_source=facebook&utm_medium=social&utm_campaign=perfil&utm_content=boton", "permanent": false },
    { "source": "/ig", "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=perfil&utm_content=bio", "permanent": false },
    { "source": "/in", "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=perfil&utm_content=pagina", "permanent": false },
    {
      "source": "/planes",
      "destination": "/precios",
      "permanent": true
    },
    {
      "source": "/aria",
      "destination": "/lici",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
