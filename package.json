{
  "name": "iautolicita-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:solo": "tsc -b && vite build",
    "probar:lici": "npx esbuild probar-lici.ts --bundle --format=esm --platform=node --outfile=.probar-lici.mjs --log-level=error && node .probar-lici.mjs && rm -f .probar-lici.mjs",
    "sync:planes": "node sincronizar-planes.mjs",
    "lici:sincronizar": "npx esbuild scripts/lici-sincronizar-conocimiento.ts --bundle --format=esm --platform=node --packages=external --outfile=.lici-sync.mjs --log-level=error && node --env-file-if-exists=.env .lici-sync.mjs",
    "lici:bateria": "npx esbuild scripts/lici-bateria.ts --bundle --format=esm --platform=node --packages=external --outfile=.lici-bateria.mjs --log-level=error && node --env-file-if-exists=.env .lici-bateria.mjs",
    "lici:plan": "npx esbuild scripts/lici-plan-prueba.ts --bundle --format=esm --platform=node --packages=external --outfile=.lici-plan.mjs --log-level=error && node --env-file-if-exists=.env .lici-plan.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
